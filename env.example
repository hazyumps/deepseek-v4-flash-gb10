# Copy to env.sh and edit. Both start scripts auto-source ../env.sh if present.
# Discover values:  ip -br link   |   ibv_devices   |   docker images

export IMAGE="vllm-ds4-sm121:cu130"     # the image you built per docs/BUILD.md
export MODEL="deepseek-ai/DeepSeek-V4-Flash"

# RoCE point-to-point link between the two Sparks (NOT your LAN IPs).
export HEAD_IP="10.255.0.1"             # node 1 RoCE IP  (rendezvous master)
export WORKER_IP="10.255.0.2"           # node 2 RoCE IP
export ROCE_IFACE="enp1s0f0np0"         # RoCE NIC interface name (same on both)
export NCCL_IB_HCA="rocep1s0f0"         # RDMA HCA name (from ibv_devices)

# Where to point the verify/ scripts (the head node's API):
export VLLM_URL="http://${HEAD_IP}:8000"
